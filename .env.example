# Copy to .env and edit. .env is git-ignored; never commit a real key.

# ollama (default), no key in this project. Install https://ollama.com, then either
#   cloud: run `ollama signin` once, use gemma4:cloud (no download; Ollama's cloud is
#          paid per token since late 2026, it had a free starter amount before)
#   local: `ollama pull qwen3:4b` (about 2.5 GB, runs on this computer)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b

# groq: cloud API with a free plan, no card. Key from https://console.groq.com -> API Keys
#   Free plan for gpt-oss-120b (Nov 2026): 30 requests and 8K tokens a minute, 200K tokens a day.
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# gemini: Google's Gemini API, free tier without a card. Key from https://aistudio.google.com/apikey
#   On the free tier Google may use prompts to improve its products.
# LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
