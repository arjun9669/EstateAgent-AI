# Copy to .env and edit. .env is git-ignored; never commit a real key.

# ollama (default): free local model, no key. Install https://ollama.com, then
#   ollama pull qwen3:4b
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b

# groq: free cloud API. Key from https://console.groq.com -> API Keys
# LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
